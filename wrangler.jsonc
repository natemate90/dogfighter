{
  "name": "dogfighter",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  // TURNSTILE_SECRET, FORM_URL and NOTIFY_FORM_URL are set in the Cloudflare dashboard and must never be in this public repo; keep_vars stops a deploy from removing them.
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "RELEASE_LIST", "id": "b2e8106fe502422c8a1deb45cff63e9e" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Previews do not inherit bindings. They share the namespace, and the Worker prefixes their keys with "preview:".
  "previews": {
    "kv_namespaces": [{ "binding": "RELEASE_LIST", "id": "b2e8106fe502422c8a1deb45cff63e9e" }]
  }
}
