ini_get() {
  [ -f "$1" ] || return 0
  LC_ALL=C awk -v s="[$2]" -v k="$3" '
    { sub(/\r$/, "") }
    /^\[/ { in_s = ($0 == s); next }
    in_s && index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1"
}

ini_set() {
  local tmp
  tmp="$(mktemp "$1.XXXXXX")"
  LC_ALL=C awk -v s="[$2]" -v k="$3" -v v="$4" '
    { cr = sub(/\r$/, "") ? "\r" : "" }
    /^\[/ {
      if (in_s && !done) { print k "=" v cr; done = 1 }
      in_s = ($0 == s); if (in_s) seen = 1
    }
    in_s && index($0, k "=") == 1 { if (!done) print k "=" v cr; done = 1; next }
    { print $0 cr }
    END { if (!seen) print s "\r"; if (!done) print k "=" v "\r" }' "$1" >"$tmp"
  mv "$tmp" "$1"
}

ini_drop_section() {
  local tmp
  tmp="$(mktemp "$1.XXXXXX")"
  LC_ALL=C awk -v s="[$2]" '
    { line = $0; sub(/\r$/, "", line) }
    line ~ /^\[/ { in_s = (line == s) }
    !in_s { print }' "$1" >"$tmp"
  mv "$tmp" "$1"
}

user_set() {
  local tmp
  tmp="$(mktemp "$USER_INI.XXXXXX")"
  LC_ALL=C awk -v k="$1" -v v="$2" '
    { line = $0; sub(/\r$/, "", line); split(line, word, " ") }
    word[1] == "sets" && word[2] == k { if (v != "" && !done) print "sets " k " \"" v "\"\r"; done = 1; next }
    { print }
    END { if (v != "" && !done) print "sets " k " \"" v "\"\r" }' "$USER_INI" >"$tmp"
  mv "$tmp" "$USER_INI"
}

address_book_add() {
  local n=0 now want
  want="$(printf %s "$1" | tr '[:upper:]' '[:lower:]')"
  while now="$(user_get "address_$n")"; [ -n "$now" ]; do
    if [ "$(printf %s "$now" | tr '[:upper:]' '[:lower:]')" = "$want" ]; then
      say "$1 is already in the game's Address book."
      return 0
    fi
    n=$((n + 1))
  done
  user_set "address_$n" "$1"
  say "Added $1 to the game's Address book: address_$n in game/user.ini."
}

first_controller() {
  /usr/bin/hidutil list --matching \
    '[{"DeviceUsagePage":1,"DeviceUsage":4},{"DeviceUsagePage":1,"DeviceUsage":5},{"DeviceUsagePage":1,"DeviceUsage":8}]' \
    2>/dev/null | LC_ALL=C awk '
    /^VendorID / { from = index($0, " Product ") + 1; to = index($0, " UserClass ") + 1; next }
    from > 1 && to > from {
      name = substr($0, from, to - from); sub(/ +$/, "", name)
      if (name == "" || name == "(null)") name = "a controller"
      print name; exit
    }' || true
}

joystick_on_for_controller() {
  local name
  [ "$AUTO_JOYSTICK" = 1 ] && [ -f "$USER_INI" ] || return 0
  [ "$(user_get option_joystick)" != true ] || return 0
  name="$(first_controller)"
  [ -n "$name" ] || return 0
  user_set option_joystick true
  say "Found $name, so Joystick is now on in the game's Options. --no-auto-joystick leaves it as it is."
}

# The game takes a screenshot only for a key that game/user.ini binds to it,
# and it writes that file again at every quit. A file that lost the line has
# no screenshot key at all.
screenshot_key_back() {
  local tmp
  [ -f "$USER_INI" ] || return 0
  LC_ALL=C awk '
    { sub(/\r$/, "") }
    $1 == "bind" && (tolower($2) == "f12" || tolower($0) ~ /"screenshot"/) { found = 1 }
    END { exit !found }' "$USER_INI" && return 0
  tmp="$(mktemp "$USER_INI.XXXXXX")"
  LC_ALL=C awk '
    NR == FNR { if ($1 == "bind") last = FNR; next }
    FNR == 1 && !last { print "bind F12  \"screenshot\"\r" }
    { print }
    FNR == last { print "bind F12  \"screenshot\"\r" }' "$USER_INI" "$USER_INI" >"$tmp"
  mv "$tmp" "$USER_INI"
  say "No key took screenshots, so F12 does again: bind F12 \"screenshot\" added to game/user.ini."
}

picture_get() {
  if [ "$1" = screen_depth ]; then ini_get "$INI" "$SECTION" "$1"; else user_get "$1"; fi
}

picture_set() {
  if [ "$1" = screen_depth ]; then ini_set "$INI" "$SECTION" "$1" "$2"; else user_set "$1" "$2"; fi
}

# The values the settings had before the launcher raised them are kept in
# $PICTURE_BEFORE, so --original can put them back.
apply_picture_settings() {
  local pair key want now
  for pair in screen_depth=32 view_distance=450 detail_volumetriclight=2 view_portals=5; do
    key="${pair%=*}" want="${pair#*=}"
    now="$(picture_get "$key")"
    if [ "$now" = "$want" ]; then continue; fi
    grep -q "^$key=" "$PICTURE_BEFORE" 2>/dev/null || echo "$key=$now" >>"$PICTURE_BEFORE"
    picture_set "$key" "$want"
    say "Picture setting $key: ${now:-not set} -> $want."
  done
}

restore_picture_settings() {
  local pair key want
  [ -f "$PICTURE_BEFORE" ] || return 0
  for pair in screen_depth=32 view_distance=450 detail_volumetriclight=2 view_portals=5; do
    key="${pair%=*}" want="${pair#*=}"
    grep -q "^$key=" "$PICTURE_BEFORE" || continue
    if [ "$(picture_get "$key")" != "$want" ]; then continue; fi
    picture_set "$key" "$(sed -n "s/^$key=//p" "$PICTURE_BEFORE")"
    say "Picture setting $key: back to $(picture_get "$key")."
  done
  rm -f "$PICTURE_BEFORE"
}

hd_set_complete() {
  [ -f "$HD_DIR/manifest.json" ] && python3 -I -B "$HERE/tools/upscale-textures.py" --check --out "$HD_DIR" 2>/dev/null
}

own_photos() {
  [ -d "$HERE/game/User/Save/Photos" ] || return 0
  python3 -I - "$HD_DIR/manifest.json" "$HERE/game/User/Save/Photos" <<'EOF' 2>/dev/null || true
import hashlib, json, os, sys
under = "user\\save\\photos\\"
with open(sys.argv[1]) as f:
    made = {record["path"].lower()[len(under):]: record["source_sha256"] for record in json.load(f)["textures"]
            if record["path"].lower().startswith(under) and record["way"] != "none"}
for name in sorted(os.listdir(sys.argv[2])):
    path = os.path.join(sys.argv[2], name)
    if name.lower() in made and os.path.isfile(path):
        with open(path, "rb") as f:
            if hashlib.sha256(f.read()).hexdigest() != made[name.lower()]:
                print(name)
EOF
}

link_cache_without() {
  local view="$1" at="" part next item name own
  shift
  rm -rf "$view"
  shopt -s nocasematch
  for part in User Save Photos ""; do
    mkdir -p "$view/$at"
    next=
    for item in "$HD_DIR/cache/$at"*; do
      [ -e "$item" ] || continue
      name="${item##*/}"
      if [ -n "$part" ] && [[ "$name" == "$part" ]]; then next="$at$name/"; continue; fi
      if [ -z "$part" ]; then
        for own in "$@"; do
          if [[ "$name" == "$own" || "$name" == "$own".[24]x ]]; then continue 2; fi
        done
      fi
      ln -s "$item" "$view/$at$name"
    done
    [ -n "$next" ] || break
    at="$next"
  done
  shopt -u nocasematch
}

# Without the larger textures no link may stay: the game would still load the
# files behind it, without the raised size limit the helper sets for them.
link_hd_textures() {
  local limit own
  limit="$(cat "$HD_DIR/texture-limit" 2>/dev/null || true)"
  if [ "$HD_TEXTURES" = 1 ] && [ -e "$CACHE_LINK" ] && [ ! -L "$CACHE_LINK" ]; then
    say "game/cache is a folder of your own, so the larger textures stay off. Move it away to use them."
    HD_TEXTURES=0
  elif [ "$HD_TEXTURES" = 1 ] && ! hd_set_complete; then
    say "No complete set of larger textures in $HD_SHOWN. Run ./setup.sh to make it."
    HD_TEXTURES=0
  fi
  if [ "$HD_TEXTURES" = 0 ]; then
    if [ -L "$CACHE_LINK" ]; then
      echo "Removed game/cache, a link to $(readlink "$CACHE_LINK")." >>"$LOG"
      rm -f "$CACHE_LINK"
    fi
    return 0
  fi
  own="$(own_photos)"
  if [ -n "$own" ]; then
    CACHE_TARGET="$WINEPREFIX/drive_c/dogfighter-cache"
    link_cache_without "$CACHE_TARGET" $own
    say "Your own pilot photos in game/User/Save/Photos stay in use: ${own//$'\n'/, }. The larger copies of the game's photos with those names are left out."
  fi
  ln -sfn "$CACHE_TARGET" "$CACHE_LINK"
  export DOGFIGHTER_TEXTURE_LIMIT="$limit"
  say "Larger textures on: up to $limit pixels a side, from ${HD_SHOWN}cache."
}

own_intros_from() {
  local i=0 name list=
  for name in $INTROS; do
    if [ "$i" -ge "$1" ]; then list="${list:+$list and }$name.avi"; fi
    i=$((i + 1))
  done
  echo "$list"
}

INTROS_SHOWN=0
play_hd_intros() {
  local name names=($INTROS) files=() args=() status=0 why box
  if [[ "${DOGFIGHTER_INTROS_SHOWN:-}" =~ ^[0-9]+$ ]]; then
    INTROS_SHOWN="$DOGFIGHTER_INTROS_SHOWN"
    return 0
  fi
  if [ -n "$DIAG_INTROS_SHOWN" ]; then
    INTROS_SHOWN="$DIAG_INTROS_SHOWN"
    return 0
  fi
  [ "$HD_VIDEOS" = 1 ] || return 0
  for name in $INTROS; do
    [ -f "$VIDEO_DIR/$name.mov" ] || break
    files+=("$VIDEO_DIR/$name.mov")
  done
  if [ "${#files[@]}" = 0 ] && [ ! -f "$VIDEO_DIR/airfix.mov" ]; then return 0; fi
  if [ -n "$DIAG" ]; then
    echo "A test run leaves out the sharper intro videos." >>"$LOG"
    return 0
  fi
  if [ "${#files[@]}" -lt 2 ]; then
    say "hd-videos/${names[${#files[@]}]}.mov is missing, so the game plays its own $(own_intros_from "${#files[@]}")."
    [ "${#files[@]}" -gt 0 ] || return 0
  fi
  if ! intro_player_fresh || ! helper_fresh; then
    say "The sharper intro videos need the newest build/ helpers, so the game plays its own. Run ./setup.sh to build them."
    return 0
  fi
  if ! known_intro_list; then
    say "game/Dogfighter.exe is not the known build, so the game plays its own intro videos."
    return 0
  fi
  box="${WINDOW_SIZE:-$LIMIT}"
  if [ "$RETINA" = y ]; then box="$((${box%x*} / 2))x$((${box#*x} / 2))"; fi
  args=(--box="$box")
  if [ "$MUTE" = 1 ]; then args+=(--mute); fi
  say "Playing the sharper intro videos. Esc, a click or any key skips one."
  why="$("$INTRO_PLAYER" "${args[@]}" "${files[@]}" 2>&1 >/dev/null)" || status=$?
  if [ -n "$why" ]; then echo "$why" >>"$LOG"; fi
  if [ "$status" -gt "${#files[@]}" ]; then
    say "The intro video player stopped (status $status), so the game plays its own intro videos."
    return 0
  fi
  INTROS_SHOWN="$status"
  if [ "$INTROS_SHOWN" -lt "${#files[@]}" ]; then
    say "hd-videos/$(basename "${files[$INTROS_SHOWN]}") did not play: ${why##*$'\n'}. The game plays its own $(own_intros_from "$INTROS_SHOWN")."
  fi
}

game_section() {
  local dev card
  dev="$(ini_get "$INI" setup current_device)"
  card="$(ini_get "$INI" "${dev:-Direct3D}" device_card)"
  [ -n "$card" ] && echo "${dev:-Direct3D}.$card"
}

clean_wrapper_leftovers() {
  local name wrapper_card='dgVoodoo DX API Layer' card
  for name in DDraw.dll D3DImm.dll d3d11.dll d3d10core.dll dxgi.dll dgVoodoo.conf Dogfighter.dxvk-cache; do
    [ ! -f "$HERE/game/$name" ] || { rm -f "$HERE/game/$name"; say "Removed game/$name, left by an old wrapper test."; }
  done
  rm -rf "$HERE/build/wrapper"
  if [ ! -f "$INI" ] || ! grep -qF "[Direct3D.$wrapper_card]" "$INI"; then return 0; fi
  ini_drop_section "$INI" "Direct3D.$wrapper_card"
  if [ "$(ini_get "$INI" Direct3D device_card)" = "$wrapper_card" ]; then
    card="$(LC_ALL=C awk '{ sub(/\r$/, "") } index($0, "[Direct3D.") == 1 { print substr($0, 11, length($0) - 11); exit }' "$INI")"
    ini_set "$INI" Direct3D device_card "$card"
  fi
  say "Removed the dgVoodoo video card from game/system.ini."
}

screen_info() {
  /usr/bin/osascript -l JavaScript -e '
    ObjC.import("AppKit");
    var s = $.NSScreen.screens.objectAtIndex(0), f = s.visibleFrame, k = s.backingScaleFactor >= 2 ? 2 : 1;
    k + " " + Math.floor(f.size.width) + " " + Math.floor(f.size.height - 28)' 2>/dev/null || true
}

REG_CHANGED=0
set_user_reg() {
  local key="$1" name="$2" value="$3" type="${4:-REG_SZ}" current want
  current="$(SEC="[${key//\\/\\\\}]" NAME="\"$name\"=" LC_ALL=C awk '
    /^\[/ { in_s = index($0, ENVIRON["SEC"]) == 1; next }
    in_s && index($0, ENVIRON["NAME"]) == 1 { print; exit }' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
  want="\"$name\"=\"$value\""
  if [ "$type" = REG_DWORD ]; then want="\"$name\"=dword:$(printf '%08x' "$value")"; fi
  [ "$current" = "$want" ] && return
  say "Setting Wine $name to $value."
  "$WINE" reg add "HKCU\\$key" /v "$name" /t "$type" /d "$value" /f >>"$LOG" 2>&1
  REG_CHANGED=1
}

fits() {
  [ "${1%x*}" -le "${RES_LIMIT%x*}" ] && [ "${1#*x}" -le "${RES_LIMIT#*x}" ]
}

largest_fit() {
  local size
  for size in $SIZES; do
    if fits "$size"; then echo "$size"; return; fi
  done
  echo 640x480
}

watch_front() {
  local flag="$1" was_front=1 pid exe
  while sleep 0.3; do
    pid="$(lsappinfo info -only pid "$(lsappinfo front 2>/dev/null)" 2>/dev/null |
      sed -n 's/.*=\([0-9][0-9]*\).*/\1/p')"
    exe=""
    [ -n "$pid" ] && exe="$(ps -o comm=,command= -p "$pid" 2>/dev/null || true)"
    if [[ "$exe" == *"$WINE_DIR/"* || "$exe" == *Dogfighter* ]]; then
      if [ "$was_front" = 0 ]; then
        : >"$flag"
        echo "focusfix: Wine is in front again" >>"$LOG"
      fi
      was_front=1
    else
      was_front=0
    fi
  done
}

watch_mac_pointer() {
  exec /usr/bin/osascript -l JavaScript -e '
    function run(argv) {
      ObjC.import("AppKit");
      ObjC.import("CoreGraphics");
      ObjC.bindFunction("CGCursorIsVisible", ["bool", []]);
      var me = Application.currentApplication(), last = "", n = 0;
      var top = $.NSScreen.screens.objectAtIndex(0).frame.size.height;
      me.includeStandardAdditions = true;
      function say(text) { console.log("mac pointer: " + new Date().toTimeString().slice(0, 8) + " " + text); }
      for (;;) {
        var front = me.doShellScript("lsappinfo info -only name $(lsappinfo front)").replace(/.*=/, "");
        var now = ($.CGCursorIsVisible() ? "shown" : "hidden") + ", in front: " + front;
        if (now !== last || ++n % 20 === 0) {
          var at = $.NSEvent.mouseLocation;
          say("at " + Math.round(at.x) + "," + Math.round(top - at.y) + " " + now);
          last = now;
        }
        delay(0.2);
      }
    }' >>"$LOG" 2>&1
}

if [ "$NATIVE" = 0 ] && ! rosetta_ok; then
  echo "Rosetta 2 is missing. Install it with:" >&2
