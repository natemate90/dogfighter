  if [ "$FULL_RES_GIVEN" = 1 ] && [ -n "$DIAG" ]; then export DOGFIGHTER_TEST_FULL_SIZE_SHOTS=1; fi
  if [ "$DEEP_Z" = 1 ]; then export DOGFIGHTER_DEEP_Z=1; fi
