#!/bin/bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dogfighter [--res=WxH] [--sharp] [--windowed=WxH] [--wide] [--original] [--setup]
                  [--no-focusfix]
                  [--debug=CHANNELS] [--diag[=focus-test[:SECONDS]|start-test|stall-test|draw-test]]
                  [--diag-keys=SECONDS:SCANCODE,...] [--diag-console=SECONDS:COMMAND]
                  [--winecfg] [--stop]

  (no option)       Play in a normal Mac window that you can resize. The picture is
                    scaled to fill it, so menu text stays readable.
                    Ctrl+Option frees the mouse, and gives it back to the game.
  --res=WxH         Use this game resolution in flight, e.g. --res=1440x900.
                    The menus are always 640x480.
  --sharp           Use Retina pixels: a sharper picture in flight.
  --windowed=WxH    Start with the picture at most this big, e.g. --windowed=1024x768.
  --wide            Widen the view angle to fit a picture wider than 4:3, so its top
                    and bottom are not cut off. The glow around lamps is not drawn
                    with this on.
  --original        Leave the picture as the game made it: 16-bit colour, the normal
                    draw distance, no light shafts, blurry ground in the distance.
                    Without this the launcher turns these up at every start.
  --setup           Show the game's setup dialog (driver, language, advanced settings)
                    and wait for OK. Without this the launcher presses OK itself.
  --no-focusfix     Start without the helper. The picture is not scaled, the window
                    has no title bar and the game stops when it loses the focus.
  --debug=CHANNELS  Write Wine debug channels to the log, e.g. --debug=+seh,+ddraw.
  --diag            Write the game's windows, display mode and cursor state to the log.
                    --diag=focus-test also runs a test with nobody at the screen: it
                    takes the focus away and gives it back, frees and takes the mouse,
                    resizes and zooms the window, then ends the game. It starts 10
                    seconds after the first picture, or after SECONDS.
                    --diag=start-test ends the game after 8 seconds of picture.
                    --diag=stall-test is the same, but treats the first start as one
                    that never drew, so the launcher has to start the game again.
                    --diag=draw-test runs a small test program in place of the game. It
                    draws straight to the screen surface, which the game never does.
                    It cannot be combined with --diag-keys or --diag-console.
  --diag-keys=LIST  Press keys in a test run, e.g. --diag-keys=30:1c,45:3b presses
                    Enter 30 seconds after the first picture and F1 at 45 seconds.
                    The codes are keyboard scan codes in hex.
  --diag-console=SECONDS:COMMAND
                    Run a game console command in a test run, e.g.
                    --diag-console=30:mode+Singleplayer, with + for each space.
                    Can be given more than once.
  --winecfg         Open Wine's settings for this game's prefix instead of playing.
  --stop            End a running game and all Wine processes of this prefix.
EOF
}

MODE=play
WINDOW_SIZE=
GAME_RES=
FOCUSFIX=1
SHARP=0
SETUP=accept
ORIGINAL=0
WIDE=0
DEBUG=
DIAG=
DIAG_KEYS=
DIAG_CONSOLE=()
PICTURE_WAIT_MS=15000
PICTURE_WAIT_FIRST_TRY=
for arg in "$@"; do
  case "$arg" in
    --windowed=*) WINDOW_SIZE="${arg#--windowed=}" ;;
    --res=*) GAME_RES="${arg#--res=}" ;;
    --sharp) SHARP=1 ;;
    --original) ORIGINAL=1 ;;
    --wide) WIDE=1 ;;
    --setup) SETUP=show ;;
    --no-focusfix) FOCUSFIX=0 ;;
    --debug=*) DEBUG="${arg#--debug=}" ;;
    --diag) DIAG=log ;;
    --diag=focus-test) DIAG=focus-test ;;
    --diag=focus-test:*) DIAG="focus-test wait=${arg#--diag=focus-test:}" ;;
    --diag=start-test) DIAG=start-test ;;
    --diag=stall-test) DIAG=start-test; PICTURE_WAIT_FIRST_TRY=1 ;;
    --diag=draw-test) DIAG=draw-test ;;
    --diag-keys=*) DIAG_KEYS="${arg#--diag-keys=}" ;;
    --diag-console=*) DIAG_CONSOLE+=("${arg#--diag-console=}") ;;
    --winecfg) MODE=winecfg ;;
    --stop) MODE=stop ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [ "$FOCUSFIX" = 0 ]; then ORIGINAL=1; fi
for size in "$WINDOW_SIZE" "$GAME_RES"; do
  [[ -z "$size" || "$size" =~ ^[0-9]+x[0-9]+$ ]] || { echo "Bad size: $size" >&2; exit 2; }
done
if [ -n "$DIAG_KEYS" ]; then
  [[ "$DIAG_KEYS" =~ ^[0-9]+:[0-9a-fA-F]+(,[0-9]+:[0-9a-fA-F]+)*$ ]] || { echo "Bad key list: $DIAG_KEYS" >&2; exit 2; }
  DIAG="${DIAG:-log} keys=$DIAG_KEYS"
fi
for command in ${DIAG_CONSOLE[@]+"${DIAG_CONSOLE[@]}"}; do
  [[ "$command" =~ ^[0-9]+:[A-Za-z0-9_.+\ ]+$ ]] || { echo "Bad console command: $command" >&2; exit 2; }
  DIAG="${DIAG:-log} console=${command// /+}"
done
if [[ "$DIAG" == draw-test\ * ]]; then
  echo "--diag=draw-test runs a test program in place of the game; leave out --diag-keys and --diag-console." >&2
  exit 2
fi
[[ "$DIAG" != *wait=* || "$DIAG" =~ wait=[0-9]+(\ |$) ]] || { echo "Bad number of seconds: $DIAG" >&2; exit 2; }
if [ "$FOCUSFIX" = 0 ] && [[ "$DIAG" == *-test* || "$DIAG" == *=* ]]; then
  echo "The diagnostic tests need the helper; leave out --no-focusfix." >&2
  exit 2
fi

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ "$SELF" == /* ]] || SELF="$LINK_DIR/$SELF"
done
HERE="$(cd -P "$(dirname "$SELF")" && pwd)"
WINE="$HERE/wine/bin/wine"
WINESERVER="$HERE/wine/bin/wineserver"
GAME_DOS='C:\Games\Dogfighter'
REG="$HERE/dogfighter.reg"
INI="$HERE/game/system.ini"
USER_INI="$HERE/game/user.ini"
PICTURE_BEFORE="$HERE/game/dogfighter-picture-before.txt"
FOCUSFIX_EXE="$HERE/build/focusfix.exe"
FOCUSHOOK_DLL="$HERE/build/focushook.dll"
WINDIAG_EXE="$HERE/build/windiag.exe"
CRASHLOG_DLL="$HERE/build/crashlog.dll"
SIZES="2560x1600 2560x1440 1920x1200 1920x1080 1680x1050 1600x1200 1600x900 1440x900
       1280x1024 1280x960 1280x800 1280x720 1024x768 800x600 640x480"

export WINEPREFIX="$HERE/prefix"
if [ "$MODE" = stop ]; then
  if [ -x "$WINESERVER" ]; then "$WINESERVER" -k 2>/dev/null || true; fi
  exit 0
fi
export WINEDEBUG="${DEBUG:-${WINEDEBUG:-fixme-all}}"
export WINEDLLOVERRIDES="winmm=n,b;mscoree=;mshtml=;ddraw=b"

mkdir -p "$HERE/logs"
LOG="$HERE/logs/run-$(date +%Y%m%d-%H%M%S).log"
: >>"$LOG"
say() { echo "$*" | tee -a "$LOG"; }

ini_get() {
  [ -f "$1" ] || return 0
  LC_ALL=C awk -v s="[$2]" -v k="$3" '
    { sub(/\r$/, "") }
    /^\[/ { in_s = ($0 == s); next }
    in_s && index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1"
}

ini_set() {
  local tmp
  tmp="$(mktemp "$1.XXXXXX")"
  LC_ALL=C awk -v s="[$2]" -v k="$3" -v v="$4" '
    { cr = sub(/\r$/, "") ? "\r" : "" }
    /^\[/ {
      if (in_s && !done) { print k "=" v cr; done = 1 }
      in_s = ($0 == s); if (in_s) seen = 1
    }
    in_s && index($0, k "=") == 1 { if (!done) print k "=" v cr; done = 1; next }
    { print $0 cr }
    END { if (!seen) print s "\r"; if (!done) print k "=" v "\r" }' "$1" >"$tmp"
  mv "$tmp" "$1"
}

ini_drop_section() {
  local tmp
  tmp="$(mktemp "$1.XXXXXX")"
  LC_ALL=C awk -v s="[$2]" '
    { line = $0; sub(/\r$/, "", line) }
    line ~ /^\[/ { in_s = (line == s) }
    !in_s { print }' "$1" >"$tmp"
  mv "$tmp" "$1"
}

user_get() {
  [ -f "$USER_INI" ] || return 0
  LC_ALL=C awk -v k="$1" '
    { sub(/\r$/, "") }
    $1 == "sets" && $2 == k { v = $3; gsub(/"/, "", v); print v; exit }' "$USER_INI"
}

user_set() {
  local tmp
  tmp="$(mktemp "$USER_INI.XXXXXX")"
  LC_ALL=C awk -v k="$1" -v v="$2" '
    { line = $0; sub(/\r$/, "", line); split(line, word, " ") }
    word[1] == "sets" && word[2] == k { if (v != "" && !done) print "sets " k " \"" v "\"\r"; done = 1; next }
    { print }
    END { if (v != "" && !done) print "sets " k " \"" v "\"\r" }' "$USER_INI" >"$tmp"
  mv "$tmp" "$USER_INI"
}

picture_get() {
  if [ "$1" = screen_depth ]; then ini_get "$INI" "$SECTION" "$1"; else user_get "$1"; fi
}

picture_set() {
  if [ "$1" = screen_depth ]; then ini_set "$INI" "$SECTION" "$1" "$2"; else user_set "$1" "$2"; fi
}

# The values the settings had before the launcher raised them are kept in
# $PICTURE_BEFORE, so --original can put them back.
apply_picture_settings() {
  local pair key want now
  for pair in screen_depth=32 view_distance=450 detail_volumetriclight=2 view_portals=5; do
    key="${pair%=*}" want="${pair#*=}"
    now="$(picture_get "$key")"
    if [ "$now" = "$want" ]; then continue; fi
    grep -q "^$key=" "$PICTURE_BEFORE" 2>/dev/null || echo "$key=$now" >>"$PICTURE_BEFORE"
    picture_set "$key" "$want"
    say "Picture setting $key: ${now:-not set} -> $want."
  done
}

restore_picture_settings() {
  local pair key want
  [ -f "$PICTURE_BEFORE" ] || return 0
  for pair in screen_depth=32 view_distance=450 detail_volumetriclight=2 view_portals=5; do
    key="${pair%=*}" want="${pair#*=}"
    grep -q "^$key=" "$PICTURE_BEFORE" || continue
    if [ "$(picture_get "$key")" != "$want" ]; then continue; fi
    picture_set "$key" "$(sed -n "s/^$key=//p" "$PICTURE_BEFORE")"
    say "Picture setting $key: back to $(picture_get "$key")."
  done
  rm -f "$PICTURE_BEFORE"
}

game_section() {
  local dev card
  dev="$(ini_get "$INI" setup current_device)"
  card="$(ini_get "$INI" "${dev:-Direct3D}" device_card)"
  [ -n "$card" ] && echo "${dev:-Direct3D}.$card"
}

clean_wrapper_leftovers() {
  local name wrapper_card='dgVoodoo DX API Layer' card
  for name in DDraw.dll D3DImm.dll d3d11.dll d3d10core.dll dxgi.dll dgVoodoo.conf Dogfighter.dxvk-cache; do
    [ ! -f "$HERE/game/$name" ] || { rm -f "$HERE/game/$name"; say "Removed game/$name, left by an old wrapper test."; }
  done
  rm -rf "$HERE/build/wrapper"
  if [ ! -f "$INI" ] || ! grep -qF "[Direct3D.$wrapper_card]" "$INI"; then return 0; fi
  ini_drop_section "$INI" "Direct3D.$wrapper_card"
  if [ "$(ini_get "$INI" Direct3D device_card)" = "$wrapper_card" ]; then
    card="$(LC_ALL=C awk '{ sub(/\r$/, "") } index($0, "[Direct3D.") == 1 { print substr($0, 11, length($0) - 11); exit }' "$INI")"
    ini_set "$INI" Direct3D device_card "$card"
  fi
  say "Removed the dgVoodoo video card from game/system.ini."
}

screen_info() {
  /usr/bin/osascript -l JavaScript -e '
    ObjC.import("AppKit");
    var s = $.NSScreen.screens.objectAtIndex(0), f = s.visibleFrame, k = s.backingScaleFactor >= 2 ? 2 : 1;
    k + " " + Math.floor(f.size.width) + " " + Math.floor(f.size.height - 28)' 2>/dev/null || true
}

REG_CHANGED=0
set_user_reg() {
  local key="$1" name="$2" value="$3" type="${4:-REG_SZ}" current want
  current="$(SEC="[${key//\\/\\\\}]" NAME="\"$name\"=" LC_ALL=C awk '
    /^\[/ { in_s = index($0, ENVIRON["SEC"]) == 1; next }
    in_s && index($0, ENVIRON["NAME"]) == 1 { print; exit }' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
  want="\"$name\"=\"$value\""
  if [ "$type" = REG_DWORD ]; then want="\"$name\"=dword:$(printf '%08x' "$value")"; fi
  [ "$current" = "$want" ] && return
  say "Setting Wine $name to $value."
  "$WINE" reg add "HKCU\\$key" /v "$name" /t "$type" /d "$value" /f >>"$LOG" 2>&1
  REG_CHANGED=1
}

fits() {
  [ "${1%x*}" -le "${LIMIT%x*}" ] && [ "${1#*x}" -le "${LIMIT#*x}" ]
}

largest_fit() {
  local size
  for size in $SIZES; do
    if fits "$size"; then echo "$size"; return; fi
  done
  echo 640x480
}

watch_front() {
  local flag="$1" was_front=1 pid exe
  while sleep 0.3; do
    pid="$(lsappinfo info -only pid "$(lsappinfo front 2>/dev/null)" 2>/dev/null |
      sed -n 's/.*=\([0-9][0-9]*\).*/\1/p')"
    exe=""
    [ -n "$pid" ] && exe="$(ps -o comm=,command= -p "$pid" 2>/dev/null || true)"
    if [[ "$exe" == *"$HERE/wine/"* || "$exe" == *Dogfighter* ]]; then
      if [ "$was_front" = 0 ]; then
        : >"$flag"
        echo "focusfix: Wine is in front again" >>"$LOG"
      fi
      was_front=1
    else
      was_front=0
    fi
  done
}

if ! /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null; then
  echo "Rosetta 2 is missing. Install it with:" >&2
  echo "  softwareupdate --install-rosetta --agree-to-license" >&2
  exit 1
fi
[ -x "$WINE" ] || { echo "Wine not found at $WINE" >&2; exit 1; }
if [ "$FOCUSFIX" = 1 ] && [ "$MODE" = play ] && { [ ! -f "$FOCUSFIX_EXE" ] || [ ! -f "$FOCUSHOOK_DLL" ]; }; then
  say "build/focusfix.exe or build/focushook.dll is missing. Run ./setup.sh to build them."
  exit 1
fi
if [ -n "$DIAG" ] && [ "$MODE" != winecfg ] && { [ ! -f "$WINDIAG_EXE" ] || [ ! -f "$CRASHLOG_DLL" ]; }; then
  say "build/windiag.exe or build/crashlog.dll is missing. Run ./setup.sh to build them."
  exit 1
fi

if [ ! -f "$WINEPREFIX/system.reg" ]; then
  say "First run: creating the Wine prefix in $WINEPREFIX (takes a minute)..."
  xattr -dr com.apple.quarantine "$HERE/wine" 2>/dev/null || true
  "$WINE" wineboot --init >>"$LOG" 2>&1
  "$WINESERVER" -w
fi

mkdir -p "$WINEPREFIX/dosdevices" "$WINEPREFIX/drive_c/Games"
ln -sfn ../../cd "$WINEPREFIX/dosdevices/d:"
ln -sfn ../../../game "$WINEPREFIX/drive_c/Games/Dogfighter"

REG_SUM="$(shasum -a 256 "$REG" | cut -d' ' -f1)"
if [ "$(cat "$WINEPREFIX/.dogfighter-reg" 2>/dev/null || true)" != "$REG_SUM" ]; then
  say "Importing $REG"
  "$WINE" regedit /S "$REG" >>"$LOG" 2>&1
  "$WINESERVER" -w
  echo "$REG_SUM" > "$WINEPREFIX/.dogfighter-reg"
fi

if [ "$MODE" = winecfg ]; then
  "$WINE" winecfg >>"$LOG" 2>&1 || true
  "$WINESERVER" -w
  say "Done. Log: $LOG"
  exit 0
fi
clean_wrapper_leftovers

SCREEN="$(screen_info)"
LIMIT=1024x768
RETINA=n
if [[ "$SCREEN" =~ ^([12])\ ([0-9]+)\ ([0-9]+)$ ]]; then
  scale="${BASH_REMATCH[1]}"
  [ "$SHARP" = 1 ] || scale=1
  if [ "$scale" = 2 ]; then RETINA=y; fi
  LIMIT="$((BASH_REMATCH[2] * scale))x$((BASH_REMATCH[3] * scale))"
else
  say "Could not read the screen size; assuming room for a $LIMIT picture."
fi

if [ -z "$GAME_RES" ]; then
  GAME_RES="$(largest_fit)"
elif ! fits "$GAME_RES"; then
  say "$GAME_RES does not fit on this screen ($LIMIT max); using $(largest_fit)."
  GAME_RES="$(largest_fit)"
fi
SECTION="$(game_section || true)"
if [ -z "$SECTION" ]; then
  say "No video card in $INI yet. Press OK in the game's setup dialog; --res applies from the next start."
  SETUP=show
elif [ "$(ini_get "$INI" "$SECTION" screen_width)x$(ini_get "$INI" "$SECTION" screen_height)" != "$GAME_RES" ]; then
  ini_set "$INI" "$SECTION" screen_width "${GAME_RES%x*}"
  ini_set "$INI" "$SECTION" screen_height "${GAME_RES#*x}"
  say "Game resolution set to $GAME_RES."
fi
if [ -n "$SECTION" ] && [ -f "$USER_INI" ]; then
  if [ "$ORIGINAL" = 1 ]; then restore_picture_settings; else apply_picture_settings; fi
fi

set_user_reg 'Software\Wine\Mac Driver' RetinaMode "$RETINA"
set_user_reg 'Software\Wine\Mac Driver' CaptureDisplaysForFullscreen n
set_user_reg 'Software\Wine\Direct3D' renderer gl
# Without the helper the game runs inside a Wine virtual desktop. win32u
# builds that desktop's mode list from this value, not from the size on the
# explorer command line, and the game needs its own resolution in the list.
if [ "$FOCUSFIX" = 0 ]; then
  set_user_reg 'Software\Wine\Explorer\Desktops' Default "$GAME_RES"
fi
set_user_reg 'Software\Wine\WineDbg' ShowCrashDialog 0 REG_DWORD
if [ "$REG_CHANGED" = 1 ]; then "$WINESERVER" -w; fi

if [ -n "$DIAG" ]; then
  cp "$WINDIAG_EXE" "$WINEPREFIX/drive_c/dogfighter-windiag.exe"
  cp "$CRASHLOG_DLL" "$WINEPREFIX/drive_c/dogfighter-crashlog.dll"
fi
WATCH_PID=
if [ "$FOCUSFIX" = 1 ]; then
  FLAG="$WINEPREFIX/drive_c/dogfighter-focusfix.flag"
  cp "$FOCUSFIX_EXE" "$WINEPREFIX/drive_c/dogfighter-focusfix.exe"
  cp "$FOCUSHOOK_DLL" "$WINEPREFIX/drive_c/dogfighter-focushook.dll"
  export DOGFIGHTER_WINDOW="${WINDOW_SIZE:-$LIMIT}"
  export DOGFIGHTER_SCREEN="${LIMIT%x*}x$((${LIMIT#*x} + 28))"
  export DOGFIGHTER_MODES="${SIZES//$'\n'/ } $GAME_RES"
  export DOGFIGHTER_SETUP="$SETUP"
  if [ "$WIDE" = 1 ]; then export DOGFIGHTER_WIDEN_VIEW=1; fi
  if [ "$ORIGINAL" = 0 ]; then export DOGFIGHTER_ANISOTROPY=16; fi
  if [ -n "$DIAG" ]; then export DOGFIGHTER_DIAG="$DIAG"; fi
  GAME_CMD=('C:\dogfighter-focusfix.exe' 'C:\dogfighter-focusfix.flag' "$GAME_DOS\\Dogfighter.exe")
  if [ "$DIAG" = draw-test ]; then
    export DOGFIGHTER_DRAWTEST=1
    unset DOGFIGHTER_DIAG
    GAME_CMD[2]='C:\dogfighter-windiag.exe'
  fi
  watch_front "$FLAG" &
  WATCH_PID=$!
  trap 'kill "$WATCH_PID" 2>/dev/null || true' EXIT
else
  GAME_CMD=(explorer "/desktop=Dogfighter,$GAME_RES" start /wait /d "$GAME_DOS" "$GAME_DOS\\Dogfighter.exe")
  if [ -n "$DIAG" ]; then
    "$WINE" explorer "/desktop=Dogfighter,$GAME_RES" 'C:\dogfighter-windiag.exe' "$DIAG" >>"$LOG" 2>&1 &
  fi
fi

run_wine() {
  say "Starting Airfix Dogfighter. Log: $LOG"
  DOGFIGHTER_PICTURE_WAIT_MS="${PICTURE_WAIT_FIRST_TRY:-$PICTURE_WAIT_MS}" "$WINE" "${GAME_CMD[@]}" >>"$LOG" 2>&1 || true
  "$WINESERVER" -w
  cat "$WINEPREFIX/drive_c/dogfighter-focusfix.log" "$WINEPREFIX/drive_c/dogfighter-focushook.log" \
    "$WINEPREFIX/drive_c/dogfighter-windiag.log" "$WINEPREFIX/drive_c/dogfighter-crash.log" \
    >>"$LOG" 2>/dev/null || true
  rm -f "$WINEPREFIX"/drive_c/dogfighter-{focusfix,focushook,windiag,crash}.log
}

# Under Rosetta, Wine sometimes runs its 32-to-64-bit switch as 32-bit code
# while the game starts Direct3D. The game then dies or hangs before its setup
# dialog shows, or hangs right after it and never draws. The helper reports
# that, and the next start usually works.
# Without the helper only Wine's own crash text tells.
START_CRASH='focusfix: the game (ended before its setup dialog appeared|got stuck while starting|drew nothing after its setup dialog)'
if [ "$FOCUSFIX" = 0 ]; then
  START_CRASH='Unhandled page fault on read access to 00004DC9|Exception frame is not in stack limits'
fi
cd "$HERE"
TRY=1
while :; do
  LOG_LINES="$(wc -l <"$LOG")"
  run_wine
  if grep -q 'drew nothing after its setup dialog' "$LOG"; then PICTURE_WAIT_FIRST_TRY=; fi
  [ "$TRY" -lt 8 ] || break
  LC_ALL=C awk -v from="$LOG_LINES" -v crash="$START_CRASH" '
    NR > from && $0 ~ crash { found = 1 } END { exit !found }' "$LOG" || break
  TRY=$((TRY + 1))
  say "The game did not get past Wine's start-up crash. Starting again (try $TRY of 8)."
done

if [ -n "$WATCH_PID" ]; then
  kill "$WATCH_PID" 2>/dev/null || true
  wait "$WATCH_PID" 2>/dev/null || true
fi
if [ -f "$HERE/game/winmm.log" ]; then
  cp "$HERE/game/winmm.log" "${LOG%.log}-music.log"
fi
say "Done. Log: $LOG"
