  if [ -n "$WATCH_PID" ]; then kill $WATCH_PID 2>/dev/null || true; fi
  if [ -n "$DIAG_HD_DIR" ] && [ -L "$CACHE_LINK" ] && [ "$(readlink "$CACHE_LINK")" = "$CACHE_TARGET" ]; then
    rm -f "$CACHE_LINK"
    if [ -n "${LOG:-}" ]; then echo "Removed game/cache, the link to the test textures." >>"$LOG"; fi
  fi
  if [ "$LOCKED" = 1 ] && [ "$(cat "$RUNNING" 2>/dev/null || true)" = $$ ]; then rm -f "$RUNNING"; fi
}
