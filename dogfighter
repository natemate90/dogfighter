fi
joystick_on_for_controller
screenshot_key_back

SCREEN="$(screen_info)"
LIMIT=1024x768
RES_LIMIT=1024x768
RETINA=n
if [[ "$SCREEN" =~ ^([12])\ ([0-9]+)\ ([0-9]+)$ ]]; then
  scale="${BASH_REMATCH[1]}"
  [ "$SHARP" = 1 ] || [ "$RETINA_WINDOW" = 1 ] || scale=1
  if [ "$scale" = 2 ]; then RETINA=y; fi
  LIMIT="$((BASH_REMATCH[2] * scale))x$((BASH_REMATCH[3] * scale))"
  RES_LIMIT="$LIMIT"
  if [ "$SHARP" = 0 ]; then RES_LIMIT="${BASH_REMATCH[2]}x${BASH_REMATCH[3]}"; fi
  if [ -n "$WINDOW_SIZE" ] && [ "$RETINA" = y ]; then WINDOW_SIZE="$((${WINDOW_SIZE%x*} * 2))x$((${WINDOW_SIZE#*x} * 2))"; fi
else
