CHECKS=0
FAILED=0
check() {
  local name="$1" fix="$2"
  shift 2
  CHECKS=$((CHECKS + 1))
  if "$@" >/dev/null 2>&1; then
    echo "ok    $name"
  else
    FAILED=$((FAILED + 1))
    echo "FAIL  $name. Fix: $fix"
  fi
}

list_controllers() {
  local lines line n=0
  if [ ! -f "$JOYLIST_EXE" ] || [ ! -f "$WINEPREFIX/system.reg" ] || ! "$WINE" --version >/dev/null 2>&1; then
    echo "      Controllers: not checked. That needs ./setup.sh and one start of the game."
    return 0
  fi
  lines="$(WINEDEBUG=-all "$WINE" "$JOYLIST_EXE" 2>/dev/null | tr -d '\r' || true)"
  if [ "$lines" = "no controller found" ]; then
    echo "      Controllers: no controller found. Connect one, then run this again."
    return 0
  fi
  while IFS= read -r line; do
    [[ "$line" == "controller "* ]] || continue
    n=$((n + 1))
    if [ "$n" = 1 ]; then
      echo "      Controller 1: ${line#controller 1: }. The game uses this one."
    else
      echo "      Controller $n: ${line#controller $n: }. Not used: the game takes the first one."
    fi
  done <<<"$lines"
  if [ "$n" = 0 ] && [[ "$lines" == error:* ]]; then
    echo "      Controllers: not checked. Wine ran, but its DirectInput did not start."
  elif [ "$n" = 0 ]; then
    echo "      Controllers: not checked. Wine did not start the program that lists them."
  elif [ "$(user_get option_joystick)" != true ]; then
    echo "      Joystick input is off in the game. The next start turns it on, unless it has --no-auto-joystick."
  fi
}

doctor() {
  local t tracks=() folder="wine$SUFFIX" get=./setup.sh
  if [ "$WINE_NAME" != stable ] && [ "$WINE_NAME" != mach9 ]; then get="unpack that Wine build into $folder/"; fi
  for t in 02 03 04 05 06 07 08 09 10 11; do tracks+=("Track$t.ogg"); done
  if [ "$WINE_PICKED" = 1 ]; then
    echo "      Checking the Wine a plain ./dogfighter uses: --wine=$WINE_NAME, in $folder/."
  fi
  check "Apple Silicon Mac" "none; this launcher needs an M1 or later" apple_silicon
  if [ "$NATIVE" = 1 ]; then
    check "Wine in $folder/ needs no Rosetta" "$get" test "$(/usr/bin/lipo -archs "$WINE" 2>/dev/null)" = arm64
  else
    check "Rosetta 2" "softwareupdate --install-rosetta --agree-to-license" rosetta_ok
  fi
  check "Wine is installed in $folder/" "$get" test -x "$WINE"
  check "macOS does not block Wine (quarantine)" "xattr -dr com.apple.quarantine $folder" not_quarantined
  check "Wine runs (wine --version)" "delete $folder/, then $get" "$WINE" --version
  check "Game files in game/" "./setup.sh" has_files "$HERE/game" \
    Dogfighter.exe AfEngine.dll Cc.dll UdsPack.dll gtDirect3D.dll Resource.up English.up
  check "CD label in cd/.windows-label" "delete cd/, then ./setup.sh" cd_label_ok
  check "Ten music tracks in music/" "./setup.sh" has_files "$HERE/music" "${tracks[@]}"
  check "Music player (game/winmm.dll, game/Music)" "./setup.sh" \
    has_files "$HERE/game" winmm.dll Music/Track02.ogg
  check "Helper is built in build/" "./setup.sh" has_files "$HERE/build" focusfix.exe focushook.dll joylist.exe
  check "Helper is newer than its source" \
    "delete build/focusfix.exe and build/focushook.dll, then ./setup.sh" helper_fresh
  check "Save folders in game/User" "./setup.sh" save_folders_ok
  if [ -f "$VIDEO_DIR/companies.mov" ] || [ -f "$VIDEO_DIR/airfix.mov" ]; then
    check "Intro video player is built in build/" "./setup.sh" intro_player_fresh
    check "game/Dogfighter.exe is the build whose intros the helper can leave out" \
      "none; the game plays its own intro videos after the sharper ones, or use --no-hd-videos" known_intro_list
    for name in $INTROS; do
      [ -f "$VIDEO_DIR/$name.mov" ] && intro_player_fresh || continue
      check "hd-videos/$name.mov plays" "delete it, then python3 tools/upscale-textures.py --videos" \
        "$INTRO_PLAYER" --check "$VIDEO_DIR/$name.mov"
    done
  fi
  list_controllers
  if [ "$FAILED" = 0 ]; then
    if [ "$WINE_PICKED" = 1 ]; then
      echo "All $CHECKS checks passed. Start the game with: ./dogfighter"
    else
      echo "All $CHECKS checks passed. Start the game with: ./dogfighter --wine=$WINE_NAME"
    fi
  else
    echo "$FAILED of $CHECKS checks failed. Do the fixes above, then run this again."
    return 1
  fi
}

saved_items() {
  local item
  for item in $SAVED; do
    if [ -e "$HERE/game/$item" ]; then echo "$item"; fi
  done
}

backup_saves() {
  local items=() item stamp file n=1
  while IFS= read -r item; do items+=("$item"); done < <(saved_items)
  [ "${#items[@]}" -gt 0 ] || { echo "Nothing to back up: game/ has no saves or settings yet." >&2; return 1; }
  mkdir -p "$BACKUPS"
  stamp="$(date +%Y%m%d-%H%M%S)"
  file="$BACKUPS/saves-$stamp.zip"
  while [ -e "$file" ]; do
    n=$((n + 1))
    file="$BACKUPS/saves-$stamp-$n.zip"
  done
  (cd "$HERE/game" && zip -qr "$file" "${items[@]}")
  echo "$file"
}

restore_saves() {
  local archive="$1" work item kept
  if [ -z "$archive" ]; then
    archive="$(find "$BACKUPS" -maxdepth 1 -name 'saves-*.zip' -exec stat -f '%m %N' {} + 2>/dev/null |
      sort -rn | sed -n '1s/^[0-9]* //p' || true)"
    [ -n "$archive" ] || { echo "No backup in backups/. Make one with: dogfighter --backup" >&2; return 1; }
  elif [ ! -f "$archive" ] && [ -f "$BACKUPS/$archive" ]; then
    archive="$BACKUPS/$archive"
  fi
  [ -f "$archive" ] || { echo "Backup not found: $archive" >&2; return 1; }
  archive="$(cd "$(dirname "$archive")" && pwd)/$(basename "$archive")"
  [ -d "$HERE/game" ] || { echo "game/ is missing. Run ./setup.sh first." >&2; return 1; }
  if pgrep -qf 'Dogfighter\.exe' 2>/dev/null; then
    echo "The game is running. Quit it first: it writes its settings again when it quits." >&2
    return 1
  fi
  mkdir -p "$BACKUPS"
  work="$(mktemp -d "$BACKUPS/restore.XXXXXX")"
  if ! unzip -q "$archive" -d "$work" 2>/dev/null || [ ! -d "$work/User" ]; then
    rm -rf "$work"
    echo "$archive is not a saves backup. Nothing was changed." >&2
    return 1
  fi
  if [ -n "$(saved_items)" ]; then
    kept="$(backup_saves)"
    echo "Current saves kept in $kept"
  fi
  for item in $SAVED; do
    [ -e "$work/$item" ] || continue
    rm -rf "$HERE/game/${item:?}"
    mv "$work/$item" "$HERE/game/$item"
  done
  rm -rf "$work"
  echo "Restored from $archive"
}

case "$MODE" in
  doctor) doctor; exit ;;
  backup) BACKUP_FILE="$(backup_saves)"; echo "Backup written to $BACKUP_FILE"; exit ;;
  restore) restore_saves "$RESTORE_FILE"; exit ;;
esac

# One game per installation: every Wine build shares game/, its settings and
# the game/cache link. The fallback to the Rosetta Wine
# keeps this process id through exec, so it finds its own lock.
take_lock() {
  [ -d "$HERE/game" ] || return 0
  if [ "$(cat "$RUNNING" 2>/dev/null || true)" != $$ ] && ! /usr/bin/shlock -p $$ -f "$RUNNING"; then
    echo "Dogfighter is already running. Stop it with ./dogfighter --stop." >&2
    exit 1
  fi
  LOCKED=1
}

LOCKED=0
WATCH_PID=
