#!/bin/bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dogfighter [--res=WxH] [--full-res|--no-full-res] [--sharp] [--retina] [--windowed=WxH] [--wide]
                  [--hd-textures|--no-hd-textures] [--hd-videos|--no-hd-videos] [--original]
                  [--smooth=0|2|4] [--deep-z] [--keep-shape|--no-keep-shape] [--fps=N]
                  [--no-pointer-match] [--mute] [--no-auto-joystick]
                  [--setup] [--no-focusfix] [--wine=NAME] [--wine-rule=KEY=VALUE]
                  [--debug=CHANNELS] [--diag[=focus-test[:SECONDS]|move-test|start-test|stall-test|crash-test|fallback-test|draw-test|press-ok|press-cancel]]
                  [--diag-keys=SECONDS:SCANCODE[:HOLDSECONDS],...] [--diag-mouse=SECONDS:DX:DY[:c|:o],...]
                  [--diag-console=SECONDS:COMMAND] [--diag-display=right] [--diag-hold] [--diag-sound]
                  [--diag-block-input]
                  [--diag-hd-dir=FOLDER] [--diag-draws] [--diag-shot-on=TEXT]
                  [--diag-intros-shown=COUNT]
                  [--diag-end=SECONDS] [--diag-zoom=SECONDS] [--diag-drag=SECONDS]
                  [--join=ADDRESS] [--winecfg] [--stop]
       dogfighter [--wine=NAME] --doctor
       dogfighter --backup | --restore[=FILE]

  (no option)       Play in a normal Mac window that you can resize, with the best
                    picture: full resolution, the larger textures when they are
                    made, and smooth edges. Menu text stays readable.
                    Ctrl+Option frees the mouse, and gives it back to the game.
  --res=WxH         Use this game resolution in flight, e.g. --res=1440x900.
                    The menus are always 640x480.
  --full-res        On by default. Draw the 3D picture, in flight and in the
                    menus, with as many pixels as the window has on a Retina
                    screen, and keep the HUD, the menus and all letters at their
                    normal size. The game goes on working in its own resolution;
                    the helper enlarges what it draws. The picture follows the
                    window when you resize or zoom it. --sharp, --retina and
                    --original turn it off unless --full-res is given too.
  --no-full-res     Draw the picture in the game's own resolution and scale it
                    to fill the window.
  --sharp           Use Retina pixels: a sharper picture in flight. The HUD and
                    the letters in a flight are then half size; full resolution
                    does not have that. Turns full resolution off.
  --retina          Draw the window with the Retina screen's own pixels, but keep
                    the game's resolution, so the HUD keeps its size. The picture
                    is then scaled once, by Wine, and not a second time by macOS.
                    Turns full resolution off. Not judged by eye yet.
  --windowed=WxH    Start with the picture at most this big, e.g. --windowed=1024x768.
                    The size is in points, the unit of Mac window sizes. On a
                    Retina screen a point is two pixels wide.
  --wide            Widen the view angle for a 16:10 or 16:9 picture. It shows more at
                    the sides and the top. The bottom edge of the picture may show a
                    stretched band in some scenes. It stays opt-in until a person has
                    judged it.
  --hd-textures     On by default. Use the larger textures in hd-textures/, which
                    ./setup.sh makes. Without a complete set there, the game uses
                    its own textures and the launcher says how to make them.
                    --original turns them off unless --hd-textures is given too.
  --no-hd-textures  Use the game's own textures.
  --hd-videos       On by default. Play the sharper intro videos in hd-videos/,
                    which the texture tool makes with --videos, before the game
                    starts, in a window like the game's. Esc, a click or any key
                    skips one. The game then leaves out its own copies. Without
                    them, or when one does not play, the game plays its own.
                    --original turns them off unless --hd-videos is given too.
                    A --diag run always leaves them out.
  --no-hd-videos    Let the game play its own intro videos.
  --original        Leave the picture as the game made it: 16-bit colour, the normal
                    draw distance, no light shafts, blurry ground in the distance,
                    jagged edges, its own resolution, its own textures and its
                    own intro videos.
                    Without this the launcher turns these up at every start.
  --smooth=N        Smooth the jagged edges of 3D shapes with N samples per pixel
                    (multisampling). The launcher uses 4 by itself. 0 turns it
                    off, as --original does. The HUD and the menus keep their size.
  --deep-z          Give the game a 24-bit depth buffer where it asks for 16 bits.
                    No difference was seen in the first mission; not tested
                    elsewhere.
  --keep-shape      On by default. Keep the window in the shape of the game's
                    picture when you resize or zoom it: drag one side and the
                    other follows. A resize and a zoom done by the test tool
                    kept the shape. A drag by hand is not tried yet.
  --no-keep-shape   Let the window take any shape. The picture is then stretched
                    to fill it.
  --fps=N           Show at most N pictures a second, from 15 to 1000, e.g.
                    --fps=60. Without it the game draws as fast as the screen
                    shows pictures, 120 a second on a ProMotion display.
  --no-pointer-match
                    Leave the speed of the pointer in the menus to the game.
                    Without this the helper makes that pointer move as far
                    over the picture as the Mac pointer moves over the window.
                    The slider "Menu mouse sensitivity" in the game's Options
                    makes it slower or faster than that.
                    Steering with the mouse in a flight is never changed.
  --mute            Start the game without sound: no videos, music or effects are
                    heard. Other apps keep their sound, and the next start without
                    this option has sound again. Every --diag run is muted.
  --no-auto-joystick
                    Leave the game's Joystick option as it is. Without this the
                    launcher turns it on when a controller is connected. It never
                    turns it off.
  --setup           Show the game's setup dialog (driver, language, advanced settings)
                    and wait for OK. Without this the launcher presses OK itself.
  --no-focusfix     Start without the helper. The picture is not scaled, the window
                    has no title bar and the game stops when it loses the focus.
                    The picture is the game's own, as with --original.
  --wine=NAME       Pick the Wine build. Without it the launcher uses Mach9, a Wine
                    that needs no Rosetta, when wine-mach9/ is there and macOS is
                    26.4 or later, and the Rosetta Wine otherwise. If the game does
                    not start on a Mach9 picked that way, it is started again on the
                    Rosetta Wine.
                    --wine=stable is the Rosetta Wine in wine/ with the prefix prefix/.
                    --wine=mach9 is Mach9 in wine-mach9/ with prefix-mach9/.
                    Any other NAME uses wine-NAME/ and prefix-NAME/.
                    --winecfg and --doctor follow the same choice. --stop without
                    --wine ends the game on both.
  --wine-rule=KEY=VALUE
                    Only with Mach9: a Mach9 setting for the game, e.g.
                    --wine-rule=env=FEX_X87REDUCEDPRECISION= for exact x87 maths.
                    Can be given more than once. The launcher adds opengl=cgl
                    (Apple's OpenGL) itself, because the game does not start on
                    Mach9's own OpenGL. An opengl= rule of your own replaces it.
  --join=ADDRESS    Write a server's IP address or host name into the game's Address
                    book in game/user.ini, then start the game. Not checked yet: that
                    the Multiplayer screen then lists the server.
  --doctor          Check the installation and print a fix for each problem.
                    Does not start the game. With --wine=NAME it checks that build.
                    It also lists the game controllers Wine sees, and says
                    whether joystick input is on in the game.
  --backup          Copy pilots, levels, photos, stickers and settings to a dated
                    zip file in backups/.
  --restore[=FILE]  Put a backup back: the newest one, or FILE. The current saves
                    are backed up first.
  --debug=CHANNELS  Write Wine debug channels to the log, e.g. --debug=+seh,+ddraw.
  --diag            Write the game's windows, display mode and cursor state to the log.
                    A run with any --diag option does not hold the mouse, so the
                    Mac stays usable. --diag-hold turns the hold back on.
                    --diag=focus-test also runs a test with nobody at the screen: it
                    takes the focus away and gives it back, frees and takes the mouse,
                    resizes and zooms the window, then ends the game. It starts 10
                    seconds after the first picture, or after SECONDS.
                    --diag=move-test frees the mouse, moves the window by 160,100,
                    sends a click for the picture and logs where the window and the
                    rectangle the mouse is kept in are after each step.
                    --diag=start-test ends the game after 8 seconds of picture.
                    --diag=stall-test is the same, but treats the first start as one
                    that never drew, so the launcher has to start the game again.
                    --diag=crash-test is the same, but ends the first start as its
                    setup dialog closes, like a crash before the first picture.
                    --diag=fallback-test is the same, but ends every start on a
                    Mach9 that was picked without --wine, so the launcher has to
                    go on with the Rosetta Wine.
                    --diag=draw-test runs a small test program in place of the game. It
                    draws straight to the screen surface, which the game never does.
                    It cannot be combined with --diag-keys, --diag-mouse or
                    --diag-console.
                    --diag=press-ok is for --no-focusfix: it presses OK in the setup
                    dialog, which the helper does otherwise.
                    --diag=press-cancel is for --setup: it presses Cancel there.
  --diag-keys=LIST  Press keys in a test run, e.g. --diag-keys=30:1c,45:3b presses
                    Enter 30 seconds after the first picture and F1 at 45 seconds.
                    The codes are keyboard scan codes in hex. 1d38 presses Ctrl+Option.
                    Codes from 80 up are the extended keys: c8 Up, d0 Down, cb Left,
                    cd Right. A third number holds the key down that long:
                    --diag-keys=45:20:20,60:c8:5 holds D from 45 to 65 seconds and Up
                    from 60 to 65. Keys whose times overlap are down together.
                    Both times can have decimals, e.g. 45.5:39:0.25.
  --diag-mouse=LIST Move the mouse in a test run, e.g. --diag-mouse=20:300:150:c moves
                    it 300 right and 150 down at 20 seconds and then clicks. Without
                    :c it only moves. :o in place of :c first puts the system pointer
                    outside the game window, then moves and clicks. The menus take
                    the mouse, not the keyboard.
  --diag-console=SECONDS:COMMAND
                    Run a game console command in a test run, e.g.
                    --diag-console=30:mode+Singleplayer, with + for each space
                    and ++ for a + itself. --diag-console=40:++thrustinc starts
                    the game's held action +thrustinc as a key press does, and
                    45:-thrustinc ends it as the key's release does. Of three
                    + in a row the first is the space: bind+x+++fire is
                    "bind x +fire". A command with a real space in it is taken
                    as written, and every + in it is a + itself:
                    --diag-console='40:bind x +fire'. SECONDS can have decimals.
                    Letters, digits, spaces and _ . + - are allowed. Give the
                    commands in order of time.
                    "pointer" is not a game command: the helper writes to the
                    log where the game's menu pointer is.
                    Can be given more than once. A command that is due while
                    the game still plays its intro videos waits for the main
                    menu: on Mach9 a mission started during them ends the game.
  --diag-display=right
                    Open the game window on the display furthest to the right, so a
                    test run stays off the screen you work on.
  --diag-hold       Hold the mouse in a test run, as a normal start does.
  --diag-block-input
                    Keep keys and mouse clicks from the game until the last
                    --diag-console command has run, so nobody starts something
                    by hand while a scripted start is on its way. The window
                    title says so. Keys from --diag-keys still reach the game;
                    clicks from --diag-mouse do not. The mouse still moves the
                    pointer. Needs --diag-console.
  --diag-end=SECONDS
                    End the game this long after its first picture, without the
                    game's own quit, so it does not write its settings.
  --diag-zoom=SECONDS
                    Zoom the window this long after the first picture.
  --diag-drag=SECONDS
                    Ask for seven window sizes as a drag of an edge or a corner
                    does, and log what the window became. The pointer is not moved.
  --diag-sound      Keep the sound in a test run, as a normal start does.
                    With any --diag option the log also says, five times a second,
                    whether macOS shows its pointer and which app is in front.
  --diag-hd-dir=FOLDER
                    Look for the larger textures in FOLDER, a full path, in place
                    of hd-textures/. An empty folder tests a start without them.
                    The link to FOLDER is removed when the run ends.
  --diag-draws      Write to the log where the game first draws each flat picture:
                    its place on the game's screen and its size. Needs the larger
                    textures to be on.
  --diag-shot-on=TEXT
                    With --full-res: save the full-size picture a few frames after
                    the game loads a picture whose path holds TEXT, e.g.
                    --diag-shot-on=loadingscreen. It lands in logs/shots/. Works
                    with and without the larger textures.
  --diag-intros-shown=COUNT
                    Start the game as if the launcher had played the first COUNT
                    sharper intro videos, 1 or 2, so the game leaves its own out.
  --winecfg         Open Wine's settings for this game's prefix instead of playing.
  --stop            End a running game and all Wine processes of this prefix.
EOF
}

MODE=play
WINDOW_SIZE=
GAME_RES=
FOCUSFIX=1
SHARP=0
RETINA_WINDOW=0
SETUP=accept
ORIGINAL=0
WIDE=0
HD_TEXTURES=auto
HD_VIDEOS=auto
MUTE=0
AUTO_JOYSTICK=1
DEBUG=
DIAG=
DIAG_KEYS=
DIAG_MOUSE=
DIAG_CONSOLE=()
DIAG_DISPLAY=
DIAG_HOLD=0
DIAG_BLOCK_INPUT=0
DIAG_SOUND=0
DIAG_HD_DIR=
DIAG_END=
DIAG_ZOOM=
DIAG_DRAG=
DIAG_DRAWS=0
DIAG_SHOT_ON=
DIAG_INTROS_SHOWN=
FULL_RES=auto
SMOOTH=4
DEEP_Z=0
KEEP_SHAPE=auto
FPS=
POINTER_MATCH=1
WINE_NAME=
WINE_RULES=
JOIN=
RESTORE_FILE=
PICTURE_WAIT_MS=15000
PICTURE_WAIT_FIRST_TRY=
END_AFTER_SETUP_FIRST_TRY=
FALLBACK_TEST=0
ARGS=("$@")
for arg in "$@"; do
  case "$arg" in
    --windowed=*) WINDOW_SIZE="${arg#--windowed=}" ;;
    --res=*) GAME_RES="${arg#--res=}" ;;
    --sharp) SHARP=1 ;;
    --retina) RETINA_WINDOW=1 ;;
    --original) ORIGINAL=1 ;;
    --wide) WIDE=1 ;;
    --hd-textures) HD_TEXTURES=1 ;;
    --no-hd-textures) HD_TEXTURES=0 ;;
    --hd-videos) HD_VIDEOS=1 ;;
    --no-hd-videos) HD_VIDEOS=0 ;;
    --mute) MUTE=1 ;;
    --no-auto-joystick) AUTO_JOYSTICK=0 ;;
    --setup) SETUP=show ;;
    --no-focusfix) FOCUSFIX=0 ;;
    --wine=*) WINE_NAME="${arg#--wine=}" ;;
    --wine-rule=*) WINE_RULES="$WINE_RULES;${arg#--wine-rule=}" ;;
    --debug=*) DEBUG="${arg#--debug=}" ;;
    --diag) DIAG=log ;;
    --diag=focus-test) DIAG=focus-test ;;
    --diag=focus-test:*) DIAG="focus-test wait=${arg#--diag=focus-test:}" ;;
    --diag=move-test) DIAG=move-test ;;
    --diag=start-test) DIAG=start-test ;;
    --diag=stall-test) DIAG=start-test; PICTURE_WAIT_FIRST_TRY=1 ;;
    --diag=crash-test) DIAG=start-test; END_AFTER_SETUP_FIRST_TRY=1 ;;
    --diag=fallback-test) DIAG=start-test; FALLBACK_TEST=1 ;;
    --diag=draw-test) DIAG=draw-test ;;
    --diag=press-ok) DIAG=press-ok ;;
    --diag=press-cancel) DIAG=press-cancel ;;
    --diag-keys=*) DIAG_KEYS="${arg#--diag-keys=}" ;;
    --diag-mouse=*) DIAG_MOUSE="${arg#--diag-mouse=}" ;;
    --diag-console=*) DIAG_CONSOLE+=("${arg#--diag-console=}") ;;
    --diag-display=right) DIAG_DISPLAY=right ;;
    --diag-hold) DIAG_HOLD=1 ;;
    --diag-block-input) DIAG_BLOCK_INPUT=1 ;;
    --diag-sound) DIAG_SOUND=1 ;;
    --diag-hd-dir=*) DIAG_HD_DIR="${arg#--diag-hd-dir=}" ;;
    --diag-end=*) DIAG_END="${arg#--diag-end=}" ;;
    --diag-zoom=*) DIAG_ZOOM="${arg#--diag-zoom=}" ;;
    --diag-drag=*) DIAG_DRAG="${arg#--diag-drag=}" ;;
    --diag-draws) DIAG_DRAWS=1 ;;
    --diag-shot-on=*) DIAG_SHOT_ON="${arg#--diag-shot-on=}" ;;
    --diag-intros-shown=*) DIAG_INTROS_SHOWN="${arg#--diag-intros-shown=}" ;;
    --full-res) FULL_RES=1 ;;
    --no-full-res) FULL_RES=0 ;;
    --smooth=*) SMOOTH="${arg#--smooth=}" ;;
    --deep-z) DEEP_Z=1 ;;
    --keep-shape) KEEP_SHAPE=1 ;;
    --no-keep-shape) KEEP_SHAPE=0 ;;
    --fps=*) FPS="${arg#--fps=}" ;;
    --no-pointer-match) POINTER_MATCH=0 ;;
    --winecfg) MODE=winecfg ;;
    --doctor) MODE=doctor ;;
    --backup) MODE=backup ;;
    --restore) MODE=restore ;;
    --restore=*) MODE=restore; RESTORE_FILE="${arg#--restore=}" ;;
    --join=*)
      JOIN="${arg#--join=}"
      [[ "$JOIN" =~ ^[0-9A-Za-z._-]{1,63}$ ]] || {
        echo "Bad address: $JOIN. Give an IP address or a host name without a port; the game always uses UDP port 19400." >&2
        exit 2
      }
      ;;
    --stop) MODE=stop ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [ "$FOCUSFIX" = 0 ]; then ORIGINAL=1; fi
if [ "$KEEP_SHAPE" = auto ]; then KEEP_SHAPE="$FOCUSFIX"; fi
FULL_RES_GIVEN="$FULL_RES"
if [ "$FULL_RES" = auto ]; then
  FULL_RES=1
  if [ "$ORIGINAL" = 1 ] || [ "$SHARP" = 1 ] || [ "$RETINA_WINDOW" = 1 ]; then FULL_RES=0; fi
fi
if [ "$FULL_RES" = 1 ]; then RETINA_WINDOW=1; fi
if [ "$HD_TEXTURES" = auto ]; then
  HD_TEXTURES=1
  if [ "$ORIGINAL" = 1 ]; then HD_TEXTURES=0; fi
fi
if [ "$HD_VIDEOS" = auto ]; then
  HD_VIDEOS=1
  if [ "$ORIGINAL" = 1 ]; then HD_VIDEOS=0; fi
fi
if [ -n "$END_AFTER_SETUP_FIRST_TRY" ] && [ "$SETUP" = show ]; then DIAG="$DIAG press-ok"; fi
for size in "$WINDOW_SIZE" "$GAME_RES"; do
  [[ -z "$size" || "$size" =~ ^[0-9]+x[0-9]+$ ]] || { echo "Bad size: $size" >&2; exit 2; }
done
if [ -n "$DIAG_KEYS" ]; then
  KEY_RE='[0-9]+(\.[0-9]+)?:[0-9a-fA-F]+(:[0-9]+(\.[0-9]+)?)?'
  [[ "$DIAG_KEYS" =~ ^$KEY_RE(,$KEY_RE)*$ ]] || { echo "Bad key list: $DIAG_KEYS" >&2; exit 2; }
  DIAG="${DIAG:-log} keys=$DIAG_KEYS"
fi
if [ "$DIAG_HOLD" = 1 ] || [ "$DIAG_SOUND" = 1 ] || [ -n "$DIAG_HD_DIR" ] || [ "$DIAG_DRAWS" = 1 ] || [ -n "$DIAG_SHOT_ON" ]; then DIAG="${DIAG:-log}"; fi
[[ "$DIAG_INTROS_SHOWN" =~ ^[12]?$ ]] || { echo "Bad number of intro videos: $DIAG_INTROS_SHOWN. Use 1 or 2." >&2; exit 2; }
if [ -n "$DIAG_INTROS_SHOWN" ]; then DIAG="${DIAG:-log}"; fi
[[ "$DIAG_SHOT_ON" =~ ^[A-Za-z0-9_.\\-]{0,60}$ ]] || { echo "Bad text: $DIAG_SHOT_ON" >&2; exit 2; }
[[ -z "$DIAG_HD_DIR" || "$DIAG_HD_DIR" == /* ]] || { echo "Bad folder: $DIAG_HD_DIR. Give a full path." >&2; exit 2; }
if [ -n "$DIAG_MOUSE" ]; then
  [[ "$DIAG_MOUSE" =~ ^[0-9]+:-?[0-9]+:-?[0-9]+(:[co])?(,[0-9]+:-?[0-9]+:-?[0-9]+(:[co])?)*$ ]] || { echo "Bad mouse list: $DIAG_MOUSE" >&2; exit 2; }
  DIAG="${DIAG:-log} mouse=$DIAG_MOUSE"
fi
for timed in "end=$DIAG_END" "zoom=$DIAG_ZOOM" "drag=$DIAG_DRAG"; do
  [ -n "${timed#*=}" ] || continue
  [[ "${timed#*=}" =~ ^[0-9]+$ ]] || { echo "Bad number of seconds: ${timed#*=}" >&2; exit 2; }
  DIAG="${DIAG:-log} $timed"
done
[[ "$SMOOTH" =~ ^(0|2|4)$ ]] || { echo "Bad --smooth value: $SMOOTH. Use 0, 2 or 4." >&2; exit 2; }
if [ -n "$FPS" ]; then
  [[ "$FPS" =~ ^[1-9][0-9]{1,3}$ ]] && [ "$FPS" -ge 15 ] && [ "$FPS" -le 1000 ] ||
    { echo "Bad --fps value: $FPS. Use a number from 15 to 1000." >&2; exit 2; }
fi
for command in ${DIAG_CONSOLE[@]+"${DIAG_CONSOLE[@]}"}; do
  [[ "$command" =~ ^[0-9]+(\.[0-9]+)?:[A-Za-z0-9_.+\ -]+$ ]] || { echo "Bad console command: $command" >&2; exit 2; }
  DIAG="${DIAG:-log} console=${command// //}"
done
if [ "$DIAG_BLOCK_INPUT" = 1 ] && [ ${#DIAG_CONSOLE[@]} = 0 ]; then
  echo "--diag-block-input lets keys and clicks through after the last --diag-console command; give one." >&2
  exit 2
fi
[[ -z "$WINE_NAME" || "$WINE_NAME" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Bad Wine name: $WINE_NAME" >&2; exit 2; }
[[ -z "$WINE_RULES" || "$WINE_RULES" =~ ^(\;[a-z0-9_]+=[A-Za-z0-9_.,=-]*)+$ ]] || { echo "Bad Wine rule: ${WINE_RULES#;}" >&2; exit 2; }
if [[ "$DIAG" == draw-test\ * ]]; then
  echo "--diag=draw-test runs a test program in place of the game; leave out --diag-keys, --diag-mouse and --diag-console." >&2
  exit 2
fi
[[ "$DIAG" != *wait=* || "$DIAG" =~ wait=[0-9]+(\ |$) ]] || { echo "Bad number of seconds: $DIAG" >&2; exit 2; }
if [ "$FOCUSFIX" = 0 ] && [ "$HD_TEXTURES" = 1 ]; then
  echo "--hd-textures needs the helper; leave out --no-focusfix." >&2
  exit 2
fi
if [ "$FOCUSFIX" = 0 ] && [ "$HD_VIDEOS" = 1 ]; then
  echo "--hd-videos needs the helper; leave out --no-focusfix." >&2
  exit 2
fi
if [ "$FOCUSFIX" = 0 ] && { [ "$RETINA_WINDOW" = 1 ] || [ "$KEEP_SHAPE" = 1 ] || [ -n "$FPS" ]; }; then
  echo "--retina, --full-res, --keep-shape and --fps need the helper; leave out --no-focusfix." >&2
  exit 2
fi
if [ "$FOCUSFIX" = 0 ] && [[ "$DIAG" == *-test* || "$DIAG" == *=* ]]; then
  echo "The diagnostic tests need the helper; leave out --no-focusfix." >&2
  exit 2
fi

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ "$SELF" == /* ]] || SELF="$LINK_DIR/$SELF"
done
HERE="${DOGFIGHTER_HOME:-$(cd -P "$(dirname "$SELF")" && pwd)}"

apple_silicon() {
  [ "$(uname -m)" = arm64 ] || [ "$(sysctl -n hw.optional.arm64 2>/dev/null || true)" = 1 ]
}

rosetta_ok() { /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null; }

# Mach9 needs macOS 26.4. DOGFIGHTER_MACOS stands in for the real version in a test.
mach9_is_default() {
  local version="${DOGFIGHTER_MACOS:-$(/usr/bin/sw_vers -productVersion 2>/dev/null || true)}" major minor
  major="${version%%.*}"
  minor=0
  if [[ "$version" == *.* ]]; then minor="${version#*.}"; fi
  minor="${minor%%.*}"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  [ "$major" -gt 26 ] || { [ "$major" -eq 26 ] && [ "$minor" -ge 4 ]; } || return 1
  apple_silicon && { [ -x "$HERE/wine-mach9/wine/bin/wine" ] || [ -x "$HERE/wine-mach9/bin/wine" ]; }
}

WINE_PICKED=0
if [ -z "$WINE_NAME" ]; then
  WINE_PICKED=1
  if mach9_is_default; then WINE_NAME=mach9; else WINE_NAME=stable; fi
fi
SUFFIX="-$WINE_NAME"
if [ "$WINE_NAME" = stable ]; then SUFFIX=; fi
WINE_DIR="$HERE/wine$SUFFIX"
if [ -x "$WINE_DIR/wine/bin/wine" ]; then WINE_DIR="$WINE_DIR/wine"; fi
WINE="$WINE_DIR/bin/wine"
WINESERVER="$WINE_DIR/bin/wineserver"
NATIVE=0
if [ -d "$WINE_DIR/lib/wine/aarch64-unix" ]; then NATIVE=1; fi
MACH9=0
MACH9_LOADER="$WINE_DIR/lib/wine/aarch64-unix/wine.app/Contents/Info.plist"
if [ -f "$WINE_DIR/lib/wine/aarch64-unix/compatdb.so" ] &&
