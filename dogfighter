clean_wrapper_leftovers
link_hd_textures
if [ "$MUTE" = 1 ]; then say "Sound is off for this start: Wine runs without its audio layer (mmdevapi) and the music player is not loaded."; fi
if [ -n "$JOIN" ]; then
  if [ ! -f "$USER_INI" ]; then
    say "game/user.ini is not there yet. Start the game once, quit it, then use --join."
    exit 1
  fi
