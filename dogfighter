  fi
else
  GAME_CMD=(explorer "/desktop=Dogfighter,$GAME_RES" start /wait /d "$GAME_DOS" "$GAME_DOS\\Dogfighter.exe")
fi

run_wine() {
  say "Starting Airfix Dogfighter. Log: $LOG"
  # The test tool ends when the game does, so each try needs its own.
  if [ "$FOCUSFIX" = 0 ] && [ -n "$DIAG" ]; then
    "$WINE" explorer "/desktop=Dogfighter,$GAME_RES" 'C:\dogfighter-windiag.exe' "$DIAG" >>"$LOG" 2>&1 &
  fi
  if [ -n "$WINE_NAME" ]; then say "Wine build: --wine=$WINE_NAME, $WINE_DIR ($("$WINE" --version 2>/dev/null || true), $(/usr/bin/lipo -archs "$WINE" 2>/dev/null || true)), prefix: $WINEPREFIX${WINE_COMPATDB:+, rules: ${WINE_COMPATDB//$'\n'/ | }}"; fi
  DOGFIGHTER_PICTURE_WAIT_MS="${PICTURE_WAIT_FIRST_TRY:-$PICTURE_WAIT_MS}" \
    DOGFIGHTER_END_AFTER_SETUP="${END_AFTER_SETUP_FIRST_TRY:-0}" "$WINE" "${GAME_CMD[@]}" >>"$LOG" 2>&1 || true
  "$WINESERVER" -w
  cat "$WINEPREFIX/drive_c/dogfighter-focusfix.log" "$WINEPREFIX/drive_c/dogfighter-focushook.log" \
    "$WINEPREFIX/drive_c/dogfighter-windiag.log" "$WINEPREFIX/drive_c/dogfighter-crash.log" \
    >>"$LOG" 2>/dev/null || true
  rm -f "$WINEPREFIX"/drive_c/dogfighter-{focusfix,focushook,windiag,crash}.log
  for shot in "$WINEPREFIX"/drive_c/dogfighter-full-size-*.tga; do
    [ -f "$shot" ] || continue
    mkdir -p "$HERE/logs/shots"
    mv "$shot" "$HERE/logs/shots/$(basename "${LOG%.log}")-${shot##*dogfighter-}" || true
  done
}

# Under Rosetta, Wine sometimes runs its 32-to-64-bit switch as 32-bit code
# while the game starts Direct3D. The game then dies or hangs before its setup
# dialog shows, or dies or hangs right after it and never draws. The helper reports
# that, and the next start usually works.
# Without the helper only Wine's own crash text tells.
START_CRASH='focusfix: the game (ended before its setup dialog appeared|got stuck while starting|drew nothing after its setup dialog|ended before its first picture)'
if [ "$FOCUSFIX" = 0 ]; then
  START_CRASH='Unhandled page fault on read access to 00004DC9|Exception frame is not in stack limits'
fi
FALLBACK=0
if [ "$WINE_PICKED" = 1 ] && [ "$WINE_NAME" = mach9 ] && [ "$FOCUSFIX" = 1 ] && [ -x "$HERE/wine/bin/wine" ] && rosetta_ok; then
  FALLBACK=1
  if [ "$FALLBACK_TEST" = 1 ]; then END_AFTER_SETUP_FIRST_TRY=1; fi
fi
TRIES=8
if [ "$FALLBACK" = 1 ]; then TRIES=2; fi
cd "$HERE"
TRY=1
STARTED=1
while :; do
  LOG_LINES="$(wc -l <"$LOG")"
  run_wine
  if grep -q 'drew nothing after its setup dialog' "$LOG"; then PICTURE_WAIT_FIRST_TRY=; fi
  if [ "$FALLBACK_TEST" = 0 ] && grep -q 'crash test: ending the game' "$LOG"; then END_AFTER_SETUP_FIRST_TRY=; fi
  STARTED=1
  LC_ALL=C awk -v from="$LOG_LINES" -v crash="$START_CRASH" '
    NR > from && $0 ~ crash { found = 1 } END { exit !found }' "$LOG" || break
  STARTED=0
  [ "$TRY" -lt "$TRIES" ] || break
  TRY=$((TRY + 1))
  say "The game did not get past Wine's start-up crash. Starting again (try $TRY of $TRIES)."
done

if [ -n "$WATCH_PID" ]; then
  kill $WATCH_PID 2>/dev/null || true
  wait $WATCH_PID 2>/dev/null || true
fi
if [ "$MUTE" = 0 ] && [ -f "$HERE/game/winmm.log" ]; then
  cp "$HERE/game/winmm.log" "${LOG%.log}-music.log"
fi
if [ "$FALLBACK" = 1 ] && [ "$STARTED" = 0 ]; then
  KEPT=()
  for arg in ${ARGS[@]+"${ARGS[@]}"}; do
    case "$arg" in --wine-rule=*) ;; *) KEPT+=("$arg") ;; esac
  done
  say "The game did not start on Mach9. Starting it with the Rosetta Wine in wine/ instead${WINE_RULES:+, without the --wine-rule settings: they are for Mach9 only}."
  exec "$HERE/dogfighter" --wine=stable ${KEPT[@]+"${KEPT[@]}"}
fi
if grep -q 'GL_INVALID_FRAMEBUFFER_OPERATION (0x506) from glClear' "$LOG"; then
  echo "About the err:d3d lines with glClear above: Wine clears each new Direct3D window once, and the game's window is not on the screen yet. The clear is left out and nothing is missing from the picture." >>"$LOG"
fi
if grep -q 'err:ntoskrnl:ZwLoadDriver.*winebth' "$LOG"; then
  echo "About the err:ntoskrnl line with winebth above: Wine's Bluetooth driver does not load on a Mac. The game does not use it; controllers come in another way." >>"$LOG"
fi
say "Done. Log: $LOG"
